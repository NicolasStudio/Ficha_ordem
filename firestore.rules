rules_version = '2';

// Cada usuário só lê e altera os próprios dados e as próprias fichas.
// O mestre também pode LER as fichas e os cadastros de todos (sem alterar nem excluir)
// e é o único com acesso às criaturas.
// Envios: o mestre manda itens, UpGrades e habilidades; o jogador lê e apaga ao receber.
service cloud.firestore {
  match /databases/{database}/documents {

    // Contas de mestre (UID do Firebase Authentication).
    // A mesma lista fica em Js/mestres.js, que só muda a interface.
    function ehMestre() {
      return request.auth != null
          && request.auth.uid in ['YSf9WSBKHIUH5nwnECRSZPlGqf33'];
    }

    match /usuarios/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || ehMestre();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /fichas/{id} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid)
                  || ehMestre();
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // Criaturas: só o mestre, e só as dele. Jogadores não têm acesso.
    match /criaturas/{id} {
      allow read, delete: if ehMestre()
                          && resource.data.uid == request.auth.uid;
      allow create: if ehMestre()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if ehMestre()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // Enviados pelo mestre para a ficha de um jogador (enviar.html).
    // O dono da ficha lê e apaga ao confirmar o recebimento; ninguém altera.
    match /envios/{id} {
      allow read, delete: if ehMestre()
                          || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if ehMestre()
                    && request.resource.data.mestreUid == request.auth.uid
                    && request.resource.data.tipo in ['item', 'upgrade', 'habilidade']
                    && get(/databases/$(database)/documents/fichas/$(request.resource.data.fichaId)).data.uid
                       == request.resource.data.uid;
    }
  }
}
